# Copy this file to .env in the project root, then fill in the three values.
# Keep the real .env on this computer. Git ignores it; never commit credentials.
# Restart the workbench after editing. Process environment values take priority.
# Use UTF-8. Quotes are optional; values are literal, with no variable expansion.

COMPANY_API_BASE_URL=
COMPANY_API_KEY=
COMPANY_CHAT_MODEL=

# Optional. The current analysis flow does not need an embedding model.
COMPANY_API_STYLE=openai_compatible
# COMPANY_EMBEDDING_MODEL=

# Optional output limit per model request: an integer from 128 to 8192.
# Unset keeps each entry point's default (workbench 2048, adapter 1024).
# Explicit Python or CLI output limits override this setting.
# Existing CLI commands pass their own defaults; use --max-output-tokens to change them.
# This changes neither request count nor source/history context limits.
# COMPANY_MAX_OUTPUT_TOKENS=4096

# Optional private framework reference (UTF-8 Markdown, kept off Git).
# Relative paths resolve from this project root, including on Windows.
# Copy your approved reference document to this location on each computer.
# This default location loads automatically when no explicit setting exists.
# FRAMEWORK_REFERENCE_PATH=.poc-data/framework/reference.md
