              "source_sha256": "29e47638142e07afcc71bdd0d4e7d5b57edc23e0379886be7a9aa4a3ad132aae",
              "evidence_id": "ev_page_6a866fe1c5da260065388754"
            },
            {
              "relative_path": "return.cbl",
              "start_line": 1,
              "end_line": 7,
              "source_sha256": "f1add39ab8cc1fa01bca5bd6321ad575682b6086de3859e9775fcc53cce6ce24",
              "evidence_id": "ev_page_e1a252b0fa6986574fd8f393"
            }
          ],
          "has_revision_draft": true,
          "deduction_missing": [
            "processing_sequence",
            "skip_conditions",
            "final_receivable"
          ],
          "requests_order_skips_and_result": true,
          "scripted_answer": "现金应收处理分两步。只有 ITEM-TYPE 等于 1-RESERVECREDIT，才从 NET-DUE 扣减 CREDIT-AMT，其他类型跳过准备金。随后独立判断当前 NET-DUE；若大于 0，CASHENTRY 将其传给 APPLYREFUND，否则跳过退款并保留当时应收。即使跳过准备金，应收为正仍检查退款。子程序只在 REFUND-BALANCE 严格小于 DUE 时减去退款余额，相等或更大则保留 DUE。按引用返回后，最终应收是初始应收减去实际扣掉的准备金和退款；两步都跳过时保持初始金额。例如应收 100、准备金 20 时，退款 30 得 50，退款 80 仍为 80。"
        }
      ],
      "job_status": "COMPLETED",
      "remaining_interim_findings": false,
      "message_roles": [
        "user",
