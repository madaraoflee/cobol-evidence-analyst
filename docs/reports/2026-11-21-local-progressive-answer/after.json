      },
      "while_first_reply_held": {
        "phase": "waiting_for_model",
        "checked_findings": [
          {
            "text": "`CASHENTRY` 的第 5 行受以下条件控制。 若`ITEM-TYPE` 等于 `\"1-RESERVECREDIT\"`，从 `NET-DUE` 中减去 `CREDIT-AMT`。若`ITEM-TYPE` 不等于 `\"1-RESERVECREDIT\"`，跳过这笔扣减。",
            "sources": [
              {
                "evidence_id": "ev_page_6a866fe1c5da260065388754",
                "relative_path": "cash.cbl",
                "start_line": 1,
                "end_line": 10
              }
            ]
          },
          {
            "text": "`APPLYREFUND` 的第 5 行受以下条件控制。 若`REFUND-BALANCE` 小于 `DUE`，从 `DUE` 中减去 `REFUND-BALANCE`。若`REFUND-BALANCE` 大于或等于 `DUE`，跳过这笔扣减。",
            "sources": [
