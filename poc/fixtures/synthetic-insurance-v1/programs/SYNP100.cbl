000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. SYNP100.
000300 DATA DIVISION.
000400 WORKING-STORAGE SECTION.
000500 01 SQLCODE                         PIC S9(09) COMP.
000600 COPY SYNPRM.
000700 PROCEDURE DIVISION.
000800 CALCULATE-BASE-PREMIUM.
000900     EXEC SQL
001000       SELECT BASE_RATE
001100         INTO :WS-BASE-RATE
001200         FROM SYN_BASE_RATE
001300        WHERE PRODUCT_CODE = :IN-PRODUCT-CODE
001400          AND COVER_CODE = :IN-BASE-COVER-CODE
001500          AND ATTAINED_AGE = :IN-ATTAINED-AGE
001600          AND SMOKER_FLAG = :IN-SMOKER-FLAG
001700          AND RATE_VERSION = :LK-RATE-VERSION
001800     END-EXEC.
001900     IF SQLCODE = ZERO
002000         COMPUTE WS-BASE-PREMIUM ROUNDED =
002100             IN-BASE-SUM-ASSURED / 1000 * WS-BASE-RATE
002200     ELSE
002300         MOVE 36 TO RETURN-CODE
002400         MOVE 'BASE-RATE-NOT-UNIQUE' TO OUT-ERROR-CODE
002500     END-IF.
002600     GOBACK.
