000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. SYNP040.
000300 DATA DIVISION.
000400 WORKING-STORAGE SECTION.
000500 01 SQLCODE                         PIC S9(09) COMP.
000600 COPY SYNPRM.
000700 PROCEDURE DIVISION.
000800 APPLY-ADJUSTMENTS.
000900     PERFORM LOAD-ADJUSTMENT-FACTORS.
001000     IF RETURN-CODE = ZERO
001100         PERFORM CALCULATE-OCCUPATION-LOADING
001200         PERFORM CALCULATE-HIGH-SUM-DISCOUNT
001300         PERFORM CALCULATE-ANNUAL-PREMIUM
001400         PERFORM CALCULATE-INSTALMENT-PREMIUM
001500     END-IF.
001600     GOBACK.
001700 LOAD-ADJUSTMENT-FACTORS.
001800     EXEC SQL
001900       SELECT LOAD_PERCENT
002000         INTO :WS-OCCUPATION-PERCENT
002100         FROM SYN_OCC_LOAD
002200        WHERE OCCUPATION_CLASS = :IN-OCCUPATION-CLASS
002300     END-EXEC.
002400     IF SQLCODE NOT = ZERO
002500         MOVE 44 TO RETURN-CODE
002600         MOVE 'ADJUSTMENT-NOT-UNIQUE' TO OUT-ERROR-CODE
002700     END-IF.
002800     EXEC SQL
002900       SELECT THRESHOLD_AMOUNT, DISCOUNT_PERCENT
003000         INTO :WS-DISCOUNT-THRESHOLD, :WS-DISCOUNT-PERCENT
003100         FROM SYN_DISCOUNT
003200        WHERE PRODUCT_CODE = :IN-PRODUCT-CODE
003300     END-EXEC.
003400     EXEC SQL
003500       SELECT MODE_FACTOR
003600         INTO :WS-MODE-FACTOR
003700         FROM SYN_MODE_FACTOR
003800        WHERE PAYMENT_MODE = :IN-PAYMENT-MODE
003900     END-EXEC.
004000     EXEC SQL
004100       SELECT ANNUAL_FEE
004200         INTO :WS-POLICY-FEE
004300         FROM SYN_POLICY_FEE
004400        WHERE PRODUCT_CODE = :IN-PRODUCT-CODE
004500     END-EXEC.
004600     EXIT.
004700 CALCULATE-OCCUPATION-LOADING.
004800     COMPUTE WS-OCCUPATION-LOADING ROUNDED =
004900         WS-BASE-PREMIUM * WS-OCCUPATION-PERCENT / 100.
005000     EXIT.
005100 CALCULATE-HIGH-SUM-DISCOUNT.
005200     MOVE ZERO TO WS-HIGH-SUM-DISCOUNT.
005300     IF IN-BASE-SUM-ASSURED >= WS-DISCOUNT-THRESHOLD
005400         COMPUTE WS-HIGH-SUM-DISCOUNT ROUNDED =
005500             WS-BASE-PREMIUM * WS-DISCOUNT-PERCENT / 100
005600     END-IF.
005700     EXIT.
005800 CALCULATE-ANNUAL-PREMIUM.
005900     COMPUTE WS-ANNUAL-PREMIUM ROUNDED =
006000         WS-BASE-PREMIUM + WS-OCCUPATION-LOADING
006100         + WS-RIDER-PREMIUM-TOTAL - WS-HIGH-SUM-DISCOUNT
006200         + WS-POLICY-FEE.
006300     COMPUTE OUT-ANNUAL-PREMIUM ROUNDED = WS-ANNUAL-PREMIUM.
006400     EXIT.
006500 CALCULATE-INSTALMENT-PREMIUM.
006600     COMPUTE OUT-INSTALMENT-PREMIUM ROUNDED =
006700         WS-ANNUAL-PREMIUM * WS-MODE-FACTOR.
006800     EXIT.
