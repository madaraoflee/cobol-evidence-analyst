000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. SYNP200.
000300 DATA DIVISION.
000400 WORKING-STORAGE SECTION.
000500 01 SQLCODE                         PIC S9(09) COMP.
000600 COPY SYNPRM.
000700 PROCEDURE DIVISION.
000800 CALCULATE-BASE-PREMIUM.
000900     EXEC SQL
001000       SELECT BASE_RATE
001100         INTO :WS-BASE-RATE
001200         FROM SYN_BASE_RATE
001300        WHERE PRODUCT_CODE = :IN-PRODUCT-CODE
001400          AND COVER_CODE = :IN-BASE-COVER-CODE
001500          AND RATE_VERSION = :LK-RATE-VERSION
001600     END-EXEC.
001700     IF SQLCODE = ZERO
001800         COMPUTE WS-BASE-PREMIUM ROUNDED =
001900             IN-BASE-SUM-ASSURED / 1000 * WS-BASE-RATE
002000     ELSE
002100         MOVE 36 TO RETURN-CODE
002200         MOVE 'BASE-RATE-NOT-UNIQUE' TO OUT-ERROR-CODE
002300     END-IF.
002400     GOBACK.
