IDENTIFICATION DIVISION.
PROGRAM-ID. BATCHRUN.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY ACCESSAREA.
01 RECORD-DECISION PIC X(4).
01 JOB-STATUS PIC X(4).
01 ERROR-CAUSE PIC X(4).
01 SCAN-DONE PIC 9.
01 RESULT-FLAG PIC 9.
01 RESTART-FLAG PIC 9.
PROCEDURE DIVISION.
COPY BATCHPATH.

1000-INITIALISE SECTION.
    MOVE ' ' TO ACCESS-FUNCTION ACCESS-STATUS.
    MOVE ' ' TO REQUEST-ID REQUEST-TYPE REQUEST-STATE TARGET-STATE.
    MOVE 'OK' TO JOB-STATUS.
    MOVE 'NONE' TO ERROR-CAUSE.
    MOVE 'SKIP' TO RECORD-DECISION.
    MOVE 0 TO SCAN-DONE RESULT-FLAG.

0900-RESTORE SECTION.
    MOVE 'RESUME' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS NOT = 'OK'
        IF ACCESS-STATUS NOT = 'END'
            MOVE 'RSER' TO JOB-STATUS ERROR-CAUSE
            MOVE 1 TO SCAN-DONE
        END-IF
    END-IF.

2000-FIRST SECTION.
    MOVE 'FIRST' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.

2100-NEXT SECTION.
    MOVE 'NEXT' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.

2500-VALIDATE SECTION.
    CALL 'REQUESTCHECK' USING REQUEST-STATE RECORD-DECISION
        ON EXCEPTION
            MOVE 'SKIP' TO RECORD-DECISION
            MOVE 'VLER' TO JOB-STATUS ERROR-CAUSE
            MOVE 1 TO SCAN-DONE
    END-CALL.

3000-UPDATE SECTION.
    MOVE 'DONE' TO TARGET-STATE.
    MOVE TARGET-STATE TO REQUEST-STATE.
    MOVE 'SAVE' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS = 'OK'
        PERFORM 3500-COMMIT
    ELSE
        IF ACCESS-STATUS = 'HELD'
            MOVE 'LOCK' TO JOB-STATUS ERROR-CAUSE
        ELSE
            MOVE 'SVER' TO JOB-STATUS ERROR-CAUSE
        END-IF
        MOVE 1 TO SCAN-DONE
        PERFORM 3600-ROLLBACK
    END-IF.

3500-COMMIT SECTION.
    MOVE 'COMMIT' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS = 'OK'
        MOVE 1 TO RESULT-FLAG
        PERFORM 3700-CHECKPOINT
    ELSE
        MOVE 'CMER' TO JOB-STATUS ERROR-CAUSE
        MOVE 1 TO SCAN-DONE
        PERFORM 3600-ROLLBACK
    END-IF.

3600-ROLLBACK SECTION.
    MOVE 'ROLLBACK' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS NOT = 'OK'
        MOVE 'RBER' TO JOB-STATUS
    END-IF.

3700-CHECKPOINT SECTION.
    MOVE 'CHECKPOINT' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS NOT = 'OK'
        MOVE 'CKPE' TO JOB-STATUS ERROR-CAUSE
        MOVE 1 TO SCAN-DONE
    END-IF.

4000-CLOSE SECTION.
    MOVE 'CLOSE' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS NOT = 'OK'
        IF JOB-STATUS = 'OK'
            MOVE 'CLER' TO JOB-STATUS ERROR-CAUSE
        END-IF
    END-IF.
