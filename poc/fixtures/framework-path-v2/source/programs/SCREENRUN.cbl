IDENTIFICATION DIVISION.
PROGRAM-ID. SCREENRUN.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY ACCESSAREA.
01 RECORD-DECISION PIC X(4).
01 SCREEN-STATUS PIC X(4).
01 ERROR-CAUSE PIC X(4).
01 SCREEN-VIEW PIC X(8).
01 RESULT-FLAG PIC 9.
PROCEDURE DIVISION.
COPY SCREENPATH.

1000-INITIALISE SECTION.
    MOVE ' ' TO ACCESS-FUNCTION ACCESS-STATUS.
    MOVE ' ' TO REQUEST-TYPE REQUEST-STATE TARGET-STATE.
    MOVE 'OK' TO SCREEN-STATUS.
    MOVE 'NONE' TO ERROR-CAUSE.
    MOVE 'SKIP' TO RECORD-DECISION.
    MOVE 'EDIT' TO SCREEN-VIEW.
    MOVE 0 TO RESULT-FLAG.

2000-GET SECTION.
    MOVE 'GET' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.

2500-VALIDATE SECTION.
    CALL 'REQUESTCHECK' USING REQUEST-STATE RECORD-DECISION
        ON EXCEPTION
            MOVE 'SKIP' TO RECORD-DECISION
            MOVE 'VLER' TO SCREEN-STATUS ERROR-CAUSE
    END-CALL.

3000-SAVE SECTION.
    MOVE 'DONE' TO TARGET-STATE.
    MOVE TARGET-STATE TO REQUEST-STATE.
    MOVE 'SAVE' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS = 'OK'
        PERFORM 3500-COMMIT
    ELSE
        IF ACCESS-STATUS = 'HELD'
            MOVE 'LOCK' TO SCREEN-STATUS ERROR-CAUSE
        ELSE
            MOVE 'SVER' TO SCREEN-STATUS ERROR-CAUSE
        END-IF
        PERFORM 3600-ROLLBACK
    END-IF.

3500-COMMIT SECTION.
    MOVE 'COMMIT' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS = 'OK'
        MOVE 1 TO RESULT-FLAG
    ELSE
        MOVE 'CMER' TO SCREEN-STATUS ERROR-CAUSE
        PERFORM 3600-ROLLBACK
    END-IF.

3600-ROLLBACK SECTION.
    MOVE 'ROLLBACK' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS NOT = 'OK'
        MOVE 'RBER' TO SCREEN-STATUS
    END-IF.

4000-NEXT-SCREEN SECTION.
    IF SCREEN-STATUS NOT = 'OK'
        MOVE 'ERROR' TO SCREEN-VIEW
    ELSE
        IF RECORD-DECISION = 'WORK'
            MOVE 'SUMMARY' TO SCREEN-VIEW
        ELSE
            MOVE 'REVIEW' TO SCREEN-VIEW
        END-IF
    END-IF.

5000-CLOSE SECTION.
    MOVE 'CLOSE' TO ACCESS-FUNCTION.
    CALL 'DATAACCESS' USING ACCESS-AREA
        ON EXCEPTION
            MOVE 'FAIL' TO ACCESS-STATUS
    END-CALL.
    IF ACCESS-STATUS NOT = 'OK'
        IF SCREEN-STATUS = 'OK'
            MOVE 'CLER' TO SCREEN-STATUS ERROR-CAUSE
        END-IF
    END-IF.
