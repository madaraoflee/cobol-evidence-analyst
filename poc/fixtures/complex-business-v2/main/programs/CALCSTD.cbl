IDENTIFICATION DIVISION.
PROGRAM-ID. CALCSTD.
DATA DIVISION.
LINKAGE SECTION.
COPY REQAREA.
COPY CALCAREA.
COPY ERRAREA.
PROCEDURE DIVISION USING REQUEST-AREA CALC-AREA ERROR-AREA.
STANDARD-CALCULATOR.
    COMPUTE CALC-ANNUAL ROUNDED =
        CALC-BASE-AMOUNT + CALC-LOAD-AMOUNT + CALC-ITEM-TOTAL
        - CALC-DISCOUNT-AMOUNT + CALC-ANNUAL-FEE
        ON SIZE ERROR
            MOVE 81 TO PROCESS-STATUS
            MOVE 'ANNUAL-CALC' TO ERROR-STAGE
            MOVE 'ANNUAL-OVERFLOW' TO ERROR-CODE
    END-COMPUTE.
    IF PROCESS-STATUS = ZERO
        COMPUTE CALC-INSTALMENT ROUNDED =
            CALC-ANNUAL * CALC-MODE-FACTOR
            ON SIZE ERROR
                MOVE 82 TO PROCESS-STATUS
                MOVE 'INSTALMENT-CALC' TO ERROR-STAGE
                MOVE 'INSTALMENT-OVERFLOW' TO ERROR-CODE
        END-COMPUTE
    END-IF.
    GOBACK.
