IDENTIFICATION DIVISION.
PROGRAM-ID. FEELOOK.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 SQLCODE PIC S9(9) COMP VALUE ZERO.
LINKAGE SECTION.
01 FEE-PRODUCT PIC X(8).
01 FEE-DATE PIC 9(8).
01 FEE-OUTPUT PIC 9(7)V99.
COPY ERRAREA.
PROCEDURE DIVISION USING FEE-PRODUCT FEE-DATE
    FEE-OUTPUT ERROR-AREA.
LOOKUP-FEE.
    EXEC SQL
        SELECT ANNUAL_FEE
          INTO :FEE-OUTPUT
          FROM FEE_CONFIG
         WHERE PRODUCT_CODE = :FEE-PRODUCT
           AND EFFECTIVE_FROM <= :FEE-DATE
           AND EFFECTIVE_TO >= :FEE-DATE
    END-EXEC.
    IF SQLCODE NOT = ZERO
        MOVE 'FEE-LOOKUP' TO ERROR-STAGE
        EVALUATE SQLCODE
            WHEN 100
                MOVE 61 TO PROCESS-STATUS
                MOVE 'FEE-MISSING' TO ERROR-CODE
            WHEN -811
                MOVE 62 TO PROCESS-STATUS
                MOVE 'FEE-AMBIGUOUS' TO ERROR-CODE
            WHEN OTHER
                MOVE 63 TO PROCESS-STATUS
                MOVE 'FEE-DATABASE-ERROR' TO ERROR-CODE
        END-EVALUATE
    END-IF.
    GOBACK.
