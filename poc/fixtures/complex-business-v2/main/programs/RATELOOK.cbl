IDENTIFICATION DIVISION.
PROGRAM-ID. RATELOOK.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 SQLCODE PIC S9(9) COMP VALUE ZERO.
01 WS-DATE-STATUS PIC S9(4) COMP.
01 WS-DATE-VALUE PIC 9(8) COMP-5.
LINKAGE SECTION.
01 RATE-PRODUCT PIC X(8).
01 RATE-DATE PIC 9(8).
01 RATE-OUTPUT PIC 9(3)V9(6).
COPY ERRAREA.
PROCEDURE DIVISION USING RATE-PRODUCT RATE-DATE
    RATE-OUTPUT ERROR-AREA.
LOOKUP-RATE.
    MOVE ZERO TO WS-DATE-STATUS.
    MOVE RATE-DATE TO WS-DATE-VALUE.
    CALL 'DATECHK' USING BY VALUE WS-DATE-VALUE
        BY REFERENCE WS-DATE-STATUS
        ON EXCEPTION
            MOVE 91 TO PROCESS-STATUS
            MOVE 'DATE-CALL' TO ERROR-STAGE
            MOVE 'PROGRAM-UNAVAILABLE' TO ERROR-CODE
    END-CALL.
    IF PROCESS-STATUS = ZERO AND WS-DATE-STATUS NOT = ZERO
        MOVE WS-DATE-STATUS TO PROCESS-STATUS
        MOVE 'RATE-DATE' TO ERROR-STAGE
        MOVE 'DATE-OUTSIDE-RANGE' TO ERROR-CODE
    END-IF.
    IF PROCESS-STATUS = ZERO
        PERFORM READ-RATE
    END-IF.
    GOBACK.
READ-RATE.
    EXEC SQL
        SELECT RATE_VALUE
          INTO :RATE-OUTPUT
          FROM RATE_CONFIG
         WHERE PRODUCT_CODE = :RATE-PRODUCT
           AND EFFECTIVE_FROM <= :RATE-DATE
           AND EFFECTIVE_TO >= :RATE-DATE
    END-EXEC.
    IF SQLCODE NOT = ZERO
        MOVE 'RATE-LOOKUP' TO ERROR-STAGE
        EVALUATE SQLCODE
            WHEN 100
                MOVE 31 TO PROCESS-STATUS
                MOVE 'RATE-MISSING' TO ERROR-CODE
            WHEN -811
                MOVE 32 TO PROCESS-STATUS
                MOVE 'RATE-AMBIGUOUS' TO ERROR-CODE
            WHEN OTHER
                MOVE 33 TO PROCESS-STATUS
                MOVE 'RATE-DATABASE-ERROR' TO ERROR-CODE
        END-EVALUATE
    END-IF.
    IF PROCESS-STATUS = ZERO AND RATE-OUTPUT = ZERO
        MOVE 34 TO PROCESS-STATUS
        MOVE 'RATE-LOOKUP' TO ERROR-STAGE
        MOVE 'RATE-NOT-POSITIVE' TO ERROR-CODE
    END-IF.
    EXIT.
