IDENTIFICATION DIVISION.
PROGRAM-ID. ADJUST.
DATA DIVISION.
LINKAGE SECTION.
COPY REQAREA.
COPY CALCAREA.
COPY ERRAREA.
PROCEDURE DIVISION USING REQUEST-AREA CALC-AREA ERROR-AREA.
APPLY-ADJUSTMENTS.
    CALL 'FACTORLK' USING BY CONTENT INPUT-MODE INPUT-DATE
        BY REFERENCE CALC-MODE-FACTOR ERROR-AREA
        ON EXCEPTION
            MOVE 91 TO PROCESS-STATUS
            MOVE 'FACTOR-CALL' TO ERROR-STAGE
            MOVE 'PROGRAM-UNAVAILABLE' TO ERROR-CODE
    END-CALL.
    IF PROCESS-STATUS = ZERO
        CALL 'FEELOOK' USING BY CONTENT INPUT-PRODUCT INPUT-DATE
            BY REFERENCE CALC-ANNUAL-FEE ERROR-AREA
            ON EXCEPTION
                MOVE 91 TO PROCESS-STATUS
                MOVE 'FEE-CALL' TO ERROR-STAGE
                MOVE 'PROGRAM-UNAVAILABLE' TO ERROR-CODE
        END-CALL
    END-IF.
    IF PROCESS-STATUS = ZERO
        PERFORM CALCULATE-LOADING
    END-IF.
    IF PROCESS-STATUS = ZERO
        PERFORM CALCULATE-DISCOUNT
    END-IF.
    GOBACK.
CALCULATE-LOADING.
    COMPUTE CALC-LOAD-AMOUNT ROUNDED =
        CALC-BASE-AMOUNT * INPUT-LOAD-PERCENT / 100
        ON SIZE ERROR
            MOVE 65 TO PROCESS-STATUS
            MOVE 'LOAD-CALC' TO ERROR-STAGE
            MOVE 'LOAD-OVERFLOW' TO ERROR-CODE
    END-COMPUTE.
    EXIT.
CALCULATE-DISCOUNT.
    MOVE ZERO TO CALC-DISCOUNT-AMOUNT.
    IF INPUT-SUM >= INPUT-DISCOUNT-LIMIT
        COMPUTE CALC-DISCOUNT-AMOUNT ROUNDED =
            CALC-BASE-AMOUNT * INPUT-DISCOUNT-PERCENT / 100
            ON SIZE ERROR
                MOVE 66 TO PROCESS-STATUS
                MOVE 'DISCOUNT-CALC' TO ERROR-STAGE
                MOVE 'DISCOUNT-OVERFLOW' TO ERROR-CODE
        END-COMPUTE
    END-IF.
    EXIT.
