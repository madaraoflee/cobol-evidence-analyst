IDENTIFICATION DIVISION.
PROGRAM-ID. TXNCORE.
DATA DIVISION.
LINKAGE SECTION.
COPY REQAREA.
COPY CALCAREA.
COPY ERRAREA.
PROCEDURE DIVISION USING REQUEST-AREA CALC-AREA ERROR-AREA.
PROCESS-REQUEST.
    PERFORM VALIDATE-INPUT THRU VALIDATE-END.
    IF PROCESS-STATUS = ZERO
        CALL 'BASECALC' USING BY CONTENT REQUEST-AREA
            BY REFERENCE CALC-AREA ERROR-AREA
            ON EXCEPTION
                MOVE 91 TO PROCESS-STATUS
                MOVE 'BASE-CALL' TO ERROR-STAGE
                MOVE 'PROGRAM-UNAVAILABLE' TO ERROR-CODE
        END-CALL
    END-IF.
    IF PROCESS-STATUS = ZERO
        CALL 'ITEMSUM' USING BY CONTENT REQUEST-AREA
            BY REFERENCE CALC-AREA ERROR-AREA
            ON EXCEPTION
                MOVE 91 TO PROCESS-STATUS
                MOVE 'ITEM-SUM-CALL' TO ERROR-STAGE
                MOVE 'PROGRAM-UNAVAILABLE' TO ERROR-CODE
        END-CALL
    END-IF.
    IF PROCESS-STATUS = ZERO
        CALL 'ADJUST' USING BY CONTENT REQUEST-AREA
            BY REFERENCE CALC-AREA ERROR-AREA
            ON EXCEPTION
                MOVE 91 TO PROCESS-STATUS
                MOVE 'ADJUST-CALL' TO ERROR-STAGE
                MOVE 'PROGRAM-UNAVAILABLE' TO ERROR-CODE
        END-CALL
    END-IF.
    IF PROCESS-STATUS = ZERO
        CALL 'ROUTESEL' USING BY CONTENT
            INPUT-PRODUCT INPUT-DATE
            BY REFERENCE CALC-ROUTE-PROGRAM ERROR-AREA
            ON EXCEPTION
                MOVE 91 TO PROCESS-STATUS
                MOVE 'ROUTE-SELECT' TO ERROR-STAGE
                MOVE 'PROGRAM-UNAVAILABLE' TO ERROR-CODE
        END-CALL
    END-IF.
    IF PROCESS-STATUS = ZERO
        CALL CALC-ROUTE-PROGRAM USING BY CONTENT REQUEST-AREA
            BY REFERENCE CALC-AREA ERROR-AREA
            ON EXCEPTION
                MOVE 92 TO PROCESS-STATUS
                MOVE 'ROUTE-CALL' TO ERROR-STAGE
                MOVE 'PROGRAM-UNAVAILABLE' TO ERROR-CODE
        END-CALL
    END-IF.
    GOBACK.
VALIDATE-INPUT.
    IF INPUT-STATUS NOT = 'P'
       AND INPUT-STATUS NOT = 'I'
        MOVE 11 TO PROCESS-STATUS
        MOVE 'INPUT' TO ERROR-STAGE
        MOVE 'INVALID-STATUS' TO ERROR-CODE
    END-IF.
    IF PROCESS-STATUS = ZERO
       AND (INPUT-SUM = ZERO OR INPUT-ITEM-COUNT > 6)
        MOVE 12 TO PROCESS-STATUS
        MOVE 'INPUT' TO ERROR-STAGE
        MOVE 'INVALID-AMOUNT-OR-COUNT' TO ERROR-CODE
    END-IF.
    IF PROCESS-STATUS = ZERO
       AND (INPUT-LOAD-PERCENT > 100
         OR INPUT-DISCOUNT-PERCENT > 100)
        MOVE 13 TO PROCESS-STATUS
        MOVE 'INPUT' TO ERROR-STAGE
        MOVE 'INVALID-PERCENT' TO ERROR-CODE
    END-IF.
VALIDATE-END.
    EXIT.
