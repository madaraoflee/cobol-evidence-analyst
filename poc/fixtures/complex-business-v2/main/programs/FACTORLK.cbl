IDENTIFICATION DIVISION.
PROGRAM-ID. FACTORLK.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 SQLCODE PIC S9(9) COMP VALUE ZERO.
LINKAGE SECTION.
01 FACTOR-MODE PIC X.
01 FACTOR-DATE PIC 9(8).
01 FACTOR-OUTPUT PIC 9V9(6).
COPY ERRAREA.
PROCEDURE DIVISION USING FACTOR-MODE FACTOR-DATE
    FACTOR-OUTPUT ERROR-AREA.
LOOKUP-FACTOR.
    EXEC SQL
        SELECT MODE_FACTOR
          INTO :FACTOR-OUTPUT
          FROM MODE_CONFIG
         WHERE PAYMENT_MODE = :FACTOR-MODE
           AND EFFECTIVE_FROM <= :FACTOR-DATE
           AND EFFECTIVE_TO >= :FACTOR-DATE
    END-EXEC.
    IF SQLCODE NOT = ZERO
        MOVE 'FACTOR-LOOKUP' TO ERROR-STAGE
        EVALUATE SQLCODE
            WHEN 100
                MOVE 51 TO PROCESS-STATUS
                MOVE 'FACTOR-MISSING' TO ERROR-CODE
            WHEN -811
                MOVE 52 TO PROCESS-STATUS
                MOVE 'FACTOR-AMBIGUOUS' TO ERROR-CODE
            WHEN OTHER
                MOVE 53 TO PROCESS-STATUS
                MOVE 'FACTOR-DATABASE-ERROR' TO ERROR-CODE
        END-EVALUATE
    END-IF.
    IF PROCESS-STATUS = ZERO AND FACTOR-OUTPUT = ZERO
        MOVE 54 TO PROCESS-STATUS
        MOVE 'FACTOR-LOOKUP' TO ERROR-STAGE
        MOVE 'FACTOR-NOT-POSITIVE' TO ERROR-CODE
    END-IF.
    GOBACK.
