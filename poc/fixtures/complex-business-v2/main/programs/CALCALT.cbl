IDENTIFICATION DIVISION.
PROGRAM-ID. CALCALT.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-ALTERNATE-SUBTOTAL PIC 9(11)V99.
LINKAGE SECTION.
COPY REQAREA.
COPY CALCAREA.
COPY ERRAREA.
PROCEDURE DIVISION USING REQUEST-AREA CALC-AREA ERROR-AREA.
ALTERNATE-CALCULATOR.
    COMPUTE WS-ALTERNATE-SUBTOTAL ROUNDED =
        CALC-BASE-AMOUNT + CALC-LOAD-AMOUNT + CALC-ITEM-TOTAL
        - CALC-DISCOUNT-AMOUNT
        ON SIZE ERROR
            MOVE 83 TO PROCESS-STATUS
            MOVE 'ALTERNATE-CALC' TO ERROR-STAGE
            MOVE 'SUBTOTAL-OVERFLOW' TO ERROR-CODE
    END-COMPUTE.
    IF PROCESS-STATUS = ZERO
        COMPUTE CALC-ANNUAL ROUNDED =
            WS-ALTERNATE-SUBTOTAL * 1.02 + CALC-ANNUAL-FEE
            ON SIZE ERROR
                MOVE 84 TO PROCESS-STATUS
                MOVE 'ALTERNATE-CALC' TO ERROR-STAGE
                MOVE 'ALTERNATE-OVERFLOW' TO ERROR-CODE
        END-COMPUTE
    END-IF.
    IF PROCESS-STATUS = ZERO
        COMPUTE CALC-INSTALMENT ROUNDED =
            CALC-ANNUAL * CALC-MODE-FACTOR
            ON SIZE ERROR
                MOVE 82 TO PROCESS-STATUS
                MOVE 'INSTALMENT-CALC' TO ERROR-STAGE
                MOVE 'INSTALMENT-OVERFLOW' TO ERROR-CODE
        END-COMPUTE
    END-IF.
    GOBACK.
